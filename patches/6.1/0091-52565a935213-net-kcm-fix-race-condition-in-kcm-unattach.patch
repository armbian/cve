---
 net/kcm/kcmsock.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/net/kcm/kcmsock.c b/net/kcm/kcmsock.c
index 7778a444ccb1..7dddf990bf65 100644
--- a/net/kcm/kcmsock.c
+++ b/net/kcm/kcmsock.c
@@ -1566,7 +1566,8 @@ static void kcm_unattach(struct kcm_psock *psock)
 		smp_mb();
 
 		/* Queue tx work to make sure psock->done is handled */
-		queue_work(kcm_wq, &psock->tx_kcm->tx_work);
+		if (!psock->tx_kcm->tx_stopped)
+			queue_work(kcm_wq, &psock->tx_kcm->tx_work);
 		spin_unlock_bh(&mux->lock);
 	} else {
 no_reserved:
