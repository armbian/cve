From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
X-Fasttrack-Source: claude
X-Fasttrack-Upstream: b53d495c7f0db46b6748b5ade48371a10dd5d3bc
X-Fasttrack-CVE: CVE-2026-90227
X-Fasttrack-Backport: cve/CVE-2026-90227/6.1
From: Yang Xiuwei <yangxiuwei@kylinos.cn>
Date: Mon, 20 Jul 2026 14:03:05 +0800
Subject: [PATCH] nvme/ioctl: check SUBMIT_IO with nvme_cmd_allowed()

commit b53d495c7f0db46b6748b5ade48371a10dd5d3bc upstream.

[ Backport: 6.1 has no nvme_cmd_allowed(). Add nvme_submit_io_allowed() with
  its partition and open-for-write checks; the CSE effects checks are left
  out, because 6.1 sets no CSUPP for I/O commands without a CSE log. ]
[ Backport: 6.1 has no NVME_IOCTL_PARTITION flag. Pass is_partition and
  open_for_write down from the block and char ioctl entry points. ]

Unlike IO_CMD / IO64_CMD, NVME_IOCTL_SUBMIT_IO never calls
nvme_cmd_allowed(). Unprivileged callers can thus issue I/O on a
partition device or write through a read-only file descriptor.

Pass flags and open_for_write through and reject disallowed commands
with -EACCES.

Reviewed-by: Christoph Hellwig <hch@lst.de>
Signed-off-by: Yang Xiuwei <yangxiuwei@kylinos.cn>
Signed-off-by: Keith Busch <kbusch@kernel.org>
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 drivers/nvme/host/ioctl.c | 55 ++++++++++++++++++++++++++++++++-------
 1 file changed, 46 insertions(+), 9 deletions(-)

diff --git a/drivers/nvme/host/ioctl.c b/drivers/nvme/host/ioctl.c
index bdc70025fb53..43e2cafd1a30 100644
--- a/drivers/nvme/host/ioctl.c
+++ b/drivers/nvme/host/ioctl.c
@@ -193,7 +193,34 @@ static int nvme_submit_user_cmd(struct request_queue *q,
 	return ret;
 }
 
-static int nvme_submit_io(struct nvme_ns *ns, struct nvme_user_io __user *uio)
+/*
+ * Subset of the upstream nvme_cmd_allowed() checks that apply to SUBMIT_IO.
+ * 6.1 has no unprivileged passthrough model for the other commands.
+ */
+static bool nvme_submit_io_allowed(struct nvme_command *c, bool is_partition,
+		bool open_for_write)
+{
+	/*
+	 * Do not allow unprivileged passthrough on partitions, as that allows an
+	 * escape from the containment of the partition.
+	 */
+	if (is_partition)
+		goto admin;
+
+	/*
+	 * Only allow I/O commands that transfer data to the controller if the
+	 * file descriptor is open for writing.
+	 */
+	if (nvme_is_write(c) && !open_for_write)
+		goto admin;
+
+	return true;
+admin:
+	return capable(CAP_SYS_ADMIN);
+}
+
+static int nvme_submit_io(struct nvme_ns *ns, struct nvme_user_io __user *uio,
+		bool is_partition, bool open_for_write)
 {
 	struct nvme_user_io io;
 	struct nvme_command c;
@@ -251,6 +278,9 @@ static int nvme_submit_io(struct nvme_ns *ns, struct nvme_user_io __user *uio)
 	c.rw.apptag = cpu_to_le16(io.apptag);
 	c.rw.appmask = cpu_to_le16(io.appmask);
 
+	if (!nvme_submit_io_allowed(&c, is_partition, open_for_write))
+		return -EACCES;
+
 	return nvme_submit_user_cmd(ns->queue, &c,
 			io.addr, length,
 			metadata, meta_len, lower_32_bits(io.slba), NULL, 0,
@@ -615,7 +645,7 @@ struct nvme_user_io32 {
 #endif /* COMPAT_FOR_U64_ALIGNMENT */
 
 static int nvme_ns_ioctl(struct nvme_ns *ns, unsigned int cmd,
-		void __user *argp)
+		void __user *argp, bool is_partition, bool open_for_write)
 {
 	switch (cmd) {
 	case NVME_IOCTL_ID:
@@ -632,7 +662,7 @@ static int nvme_ns_ioctl(struct nvme_ns *ns, unsigned int cmd,
 	case NVME_IOCTL_SUBMIT_IO32:
 #endif
 	case NVME_IOCTL_SUBMIT_IO:
-		return nvme_submit_io(ns, argp);
+		return nvme_submit_io(ns, argp, is_partition, open_for_write);
 	case NVME_IOCTL_IO64_CMD:
 		return nvme_user_cmd64(ns->ctrl, ns, argp, false);
 	case NVME_IOCTL_IO64_CMD_VEC:
@@ -642,27 +672,31 @@ static int nvme_ns_ioctl(struct nvme_ns *ns, unsigned int cmd,
 	}
 }
 
-static int __nvme_ioctl(struct nvme_ns *ns, unsigned int cmd, void __user *arg)
+static int __nvme_ioctl(struct nvme_ns *ns, unsigned int cmd, void __user *arg,
+		bool is_partition, bool open_for_write)
 {
        if (is_ctrl_ioctl(cmd))
                return nvme_ctrl_ioctl(ns->ctrl, cmd, arg);
-       return nvme_ns_ioctl(ns, cmd, arg);
+       return nvme_ns_ioctl(ns, cmd, arg, is_partition, open_for_write);
 }
 
 int nvme_ioctl(struct block_device *bdev, fmode_t mode,
 		unsigned int cmd, unsigned long arg)
 {
 	struct nvme_ns *ns = bdev->bd_disk->private_data;
+	bool open_for_write = mode & FMODE_WRITE;
 
-	return __nvme_ioctl(ns, cmd, (void __user *)arg);
+	return __nvme_ioctl(ns, cmd, (void __user *)arg,
+			    bdev_is_partition(bdev), open_for_write);
 }
 
 long nvme_ns_chr_ioctl(struct file *file, unsigned int cmd, unsigned long arg)
 {
 	struct nvme_ns *ns =
 		container_of(file_inode(file)->i_cdev, struct nvme_ns, cdev);
+	bool open_for_write = file->f_mode & FMODE_WRITE;
 
-	return __nvme_ioctl(ns, cmd, (void __user *)arg);
+	return __nvme_ioctl(ns, cmd, (void __user *)arg, false, open_for_write);
 }
 
 static int nvme_uring_cmd_checks(unsigned int issue_flags)
@@ -748,6 +782,7 @@ int nvme_ns_head_ioctl(struct block_device *bdev, fmode_t mode,
 		unsigned int cmd, unsigned long arg)
 {
 	struct nvme_ns_head *head = bdev->bd_disk->private_data;
+	bool open_for_write = mode & FMODE_WRITE;
 	void __user *argp = (void __user *)arg;
 	struct nvme_ns *ns;
 	int srcu_idx, ret = -EWOULDBLOCK;
@@ -765,7 +800,8 @@ int nvme_ns_head_ioctl(struct block_device *bdev, fmode_t mode,
 	if (is_ctrl_ioctl(cmd))
 		return nvme_ns_head_ctrl_ioctl(ns, cmd, argp, head, srcu_idx);
 
-	ret = nvme_ns_ioctl(ns, cmd, argp);
+	ret = nvme_ns_ioctl(ns, cmd, argp, bdev_is_partition(bdev),
+			    open_for_write);
 out_unlock:
 	srcu_read_unlock(&head->srcu, srcu_idx);
 	return ret;
@@ -777,6 +813,7 @@ long nvme_ns_head_chr_ioctl(struct file *file, unsigned int cmd,
 	struct cdev *cdev = file_inode(file)->i_cdev;
 	struct nvme_ns_head *head =
 		container_of(cdev, struct nvme_ns_head, cdev);
+	bool open_for_write = file->f_mode & FMODE_WRITE;
 	void __user *argp = (void __user *)arg;
 	struct nvme_ns *ns;
 	int srcu_idx, ret = -EWOULDBLOCK;
@@ -789,7 +826,7 @@ long nvme_ns_head_chr_ioctl(struct file *file, unsigned int cmd,
 	if (is_ctrl_ioctl(cmd))
 		return nvme_ns_head_ctrl_ioctl(ns, cmd, argp, head, srcu_idx);
 
-	ret = nvme_ns_ioctl(ns, cmd, argp);
+	ret = nvme_ns_ioctl(ns, cmd, argp, false, open_for_write);
 out_unlock:
 	srcu_read_unlock(&head->srcu, srcu_idx);
 	return ret;
