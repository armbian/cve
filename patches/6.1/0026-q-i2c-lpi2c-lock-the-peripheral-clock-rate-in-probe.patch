From: Igor Pecovnik <igor@armbian.com>
Date: Mon, 2 Nov 2026 05:58:17 +0100
Subject: [PATCH] i2c: lpi2c: lock the peripheral clock rate in probe

The 6.1 backport of 4268254a3948 ("i2c: lpi2c: Avoid calling
clk_get_rate during transfer") caches the clock rate in probe. It drops
the upstream devm_clk_rate_exclusive_get() call, because 6.1 does not
have that function. Then the clock rate can change after probe and the
cached rate becomes incorrect.

Lock the rate with clk_rate_exclusive_get(). Release it with a devm
action, as devm_clk_rate_exclusive_get() does upstream.

CVE: CVE-2024-40965
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 drivers/i2c/busses/i2c-imx-lpi2c.c | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/drivers/i2c/busses/i2c-imx-lpi2c.c b/drivers/i2c/busses/i2c-imx-lpi2c.c
index a6913b14107e..aa9be00e1d6e 100644
--- a/drivers/i2c/busses/i2c-imx-lpi2c.c
+++ b/drivers/i2c/busses/i2c-imx-lpi2c.c
@@ -545,6 +545,11 @@ static const struct of_device_id lpi2c_imx_of_match[] = {
 };
 MODULE_DEVICE_TABLE(of, lpi2c_imx_of_match);
 
+static void lpi2c_imx_clk_rate_put(void *data)
+{
+	clk_rate_exclusive_put(data);
+}
+
 static int lpi2c_imx_probe(struct platform_device *pdev)
 {
 	struct lpi2c_imx_struct *lpi2c_imx;
@@ -596,6 +601,20 @@ static int lpi2c_imx_probe(struct platform_device *pdev)
 	if (ret)
 		return ret;
 
+	/*
+	 * Lock the parent clock rate to avoid getting parent clock upon
+	 * each transfer
+	 */
+	ret = clk_rate_exclusive_get(lpi2c_imx->clks[0].clk);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "can't lock I2C peripheral clock rate\n");
+
+	ret = devm_add_action_or_reset(&pdev->dev, lpi2c_imx_clk_rate_put,
+				       lpi2c_imx->clks[0].clk);
+	if (ret)
+		return ret;
+
 	lpi2c_imx->rate_per = clk_get_rate(lpi2c_imx->clks[0].clk);
 	if (!lpi2c_imx->rate_per)
 		return dev_err_probe(&pdev->dev, -EINVAL,
