diff --git a/drivers/md/md-bitmap.c b/drivers/md/md-bitmap.c
index 2e73be016d3c..40a1c4f80e6d 100644
--- a/drivers/md/md-bitmap.c
+++ b/drivers/md/md-bitmap.c
@@ -2271,6 +2271,7 @@ static ssize_t
 location_store(struct mddev *mddev, const char *buf, size_t len)
 {
 	int rv;
+	unsigned int noio_flags;
 
 	rv = mddev_lock(mddev);
 	if (rv)
@@ -2335,6 +2336,7 @@ location_store(struct mddev *mddev, const char *buf, size_t len)
 				struct bitmap *bitmap;
 				bitmap = md_bitmap_create(mddev, -1);
 				mddev_suspend(mddev);
+				noio_flags = memalloc_noio_save();
 				if (IS_ERR(bitmap))
 					rv = PTR_ERR(bitmap);
 				else {
@@ -2345,9 +2347,11 @@ location_store(struct mddev *mddev, const char *buf, size_t len)
 				}
 				if (rv) {
 					md_bitmap_destroy(mddev);
+					memalloc_noio_restore(noio_flags);
 					mddev_resume(mddev);
 					goto out;
 				}
+				memalloc_noio_restore(noio_flags);
 				mddev_resume(mddev);
 			}
 		}
