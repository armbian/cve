X-Fasttrack-Source: claude
X-Fasttrack-Upstream: b80bed5c871a80151351342c065579405ce77145
X-Fasttrack-CVE: CVE-2026-74592
X-Fasttrack-Backport: cve/CVE-2026-74592/6.1
From: Mimi Zohar <zohar@linux.ibm.com>
Date: Sun, 1 Nov 2026 15:02:22 +0100
Subject: [PATCH] ima: Instantiate file_truncate and path_truncate hooks

commit b80bed5c871a80151351342c065579405ce77145 upstream.

[ Backport: 6.1 IMA is not an LSM and has no file_truncate hook. Call
  ima_path_truncate()/ima_file_truncate() from the VFS after
  security_path_truncate() succeeds, like ima_post_path_mknod(). ]
[ Backport: use integrity_iint_find() and struct integrity_iint_cache. ]
[ Backport: the helpers return void and get prototypes in linux/ima.h. ]

Instantiate the file_truncate and path_truncate LSM hooks to reset the
action cache flags (IMA_DONE_MASK) as soon as truncation is requested,
so the file, based on policy, is re-collected, re-measured, re-audited,
and re-appraised on next access.

Tested-by: Frederick Lawler <fred@cloudflare.com>
Cc: stable@vger.kernel.org
Signed-off-by: Mimi Zohar <zohar@linux.ibm.com>
---
 fs/namei.c                        |  1 +
 fs/open.c                         |  8 +++++--
 include/linux/ima.h               | 12 +++++++++++
 security/integrity/ima/ima_main.c | 35 +++++++++++++++++++++++++++++++
 4 files changed, 54 insertions(+), 2 deletions(-)

diff --git a/fs/namei.c b/fs/namei.c
index 8479b7d27016..efd4f219cec8 100644
--- a/fs/namei.c
+++ b/fs/namei.c
@@ -3362,6 +3362,7 @@ static int handle_truncate(struct user_namespace *mnt_userns, struct file *filp)
 
 	error = security_path_truncate(path);
 	if (!error) {
+		ima_file_truncate(filp);
 		error = do_truncate(mnt_userns, path->dentry, 0,
 				    ATTR_MTIME|ATTR_CTIME|ATTR_OPEN,
 				    filp);
diff --git a/fs/open.c b/fs/open.c
index 85466cd40c40..dd822f1d6fa5 100644
--- a/fs/open.c
+++ b/fs/open.c
@@ -107,8 +107,10 @@ long vfs_truncate(const struct path *path, loff_t length)
 		goto put_write_and_out;
 
 	error = security_path_truncate(path);
-	if (!error)
+	if (!error) {
+		ima_path_truncate(path);
 		error = do_truncate(mnt_userns, path->dentry, length, 0, NULL);
+	}
 
 put_write_and_out:
 	put_write_access(inode);
@@ -189,9 +191,11 @@ long do_sys_ftruncate(unsigned int fd, loff_t length, int small)
 		goto out_putf;
 	sb_start_write(inode->i_sb);
 	error = security_path_truncate(&f.file->f_path);
-	if (!error)
+	if (!error) {
+		ima_file_truncate(f.file);
 		error = do_truncate(file_mnt_user_ns(f.file), dentry, length,
 				    ATTR_MTIME | ATTR_CTIME, f.file);
+	}
 	sb_end_write(inode->i_sb);
 out_putf:
 	fdput(f);
diff --git a/include/linux/ima.h b/include/linux/ima.h
index 21f442c3fa88..f1d13bc6bb4a 100644
--- a/include/linux/ima.h
+++ b/include/linux/ima.h
@@ -33,6 +33,8 @@ extern int ima_post_read_file(struct file *file, void *buf, loff_t size,
 			      enum kernel_read_file_id id);
 extern void ima_post_path_mknod(struct user_namespace *mnt_userns,
 				struct dentry *dentry);
+extern void ima_path_truncate(const struct path *path);
+extern void ima_file_truncate(struct file *file);
 extern int ima_file_hash(struct file *file, char *buf, size_t buf_size);
 extern int ima_inode_hash(struct inode *inode, char *buf, size_t buf_size);
 extern void ima_kexec_cmdline(int kernel_fd, const void *buf, int size);
@@ -119,6 +121,16 @@ static inline void ima_post_path_mknod(struct user_namespace *mnt_userns,
 	return;
 }
 
+static inline void ima_path_truncate(const struct path *path)
+{
+	return;
+}
+
+static inline void ima_file_truncate(struct file *file)
+{
+	return;
+}
+
 static inline int ima_file_hash(struct file *file, char *buf, size_t buf_size)
 {
 	return -EOPNOTSUPP;
diff --git a/security/integrity/ima/ima_main.c b/security/integrity/ima/ima_main.c
index 185666d90eeb..e32462ff534c 100644
--- a/security/integrity/ima/ima_main.c
+++ b/security/integrity/ima/ima_main.c
@@ -537,6 +537,41 @@ int ima_file_check(struct file *file, int mask)
 }
 EXPORT_SYMBOL_GPL(ima_file_check);
 
+/*
+ * ima_reset_action_flags - invalidate action flags after a content change
+ * @inode: inode of the file whose content is about to be truncated
+ *
+ * Clear IMA_DONE_MASK so the file is re-collected, re-measured,
+ * re-audited, and re-appraised on next access.
+ */
+static void ima_reset_action_flags(struct inode *inode)
+{
+	struct integrity_iint_cache *iint;
+
+	if (!ima_policy_flag || !S_ISREG(inode->i_mode))
+		return;
+
+	iint = integrity_iint_find(inode);
+	if (!iint)
+		return;
+
+	mutex_lock(&iint->mutex);
+	iint->flags &= ~IMA_DONE_MASK;
+	iint->measured_pcrs = 0;
+	mutex_unlock(&iint->mutex);
+	return;
+}
+
+void ima_path_truncate(const struct path *path)
+{
+	ima_reset_action_flags(path->dentry->d_inode);
+}
+
+void ima_file_truncate(struct file *file)
+{
+	ima_reset_action_flags(file_inode(file));
+}
+
 static int __ima_inode_hash(struct inode *inode, struct file *file, char *buf,
 			    size_t buf_size)
 {
