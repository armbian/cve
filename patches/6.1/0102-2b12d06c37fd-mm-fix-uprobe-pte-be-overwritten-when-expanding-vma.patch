---
 mm/mmap.c | 72 ++++++++++++++++++++++++++++++++++++++++---------------
 1 file changed, 53 insertions(+), 19 deletions(-)

diff --git a/mm/mmap.c b/mm/mmap.c
index 1eb86aba7de5..6ffa0cf485c0 100644
--- a/mm/mmap.c
+++ b/mm/mmap.c
@@ -618,9 +618,9 @@ inline int vma_expand(struct ma_state *mas, struct vm_area_struct *vma,
  * are necessary.  The "insert" vma (if any) is to be inserted
  * before we drop the necessary locks.
  */
-int __vma_adjust(struct vm_area_struct *vma, unsigned long start,
+static int ___vma_adjust(struct vm_area_struct *vma, unsigned long start,
 	unsigned long end, pgoff_t pgoff, struct vm_area_struct *insert,
-	struct vm_area_struct *expand)
+	struct vm_area_struct *expand, bool skip_vma_uprobe)
 {
 	struct mm_struct *mm = vma->vm_mm;
 	struct vm_area_struct *next_next = NULL;	/* uninit var warning */
@@ -842,10 +842,13 @@ int __vma_adjust(struct vm_area_struct *vma, unsigned long start,
 
 	if (file) {
 		i_mmap_unlock_write(mapping);
-		uprobe_mmap(vma);
 
-		if (adjust_next)
-			uprobe_mmap(next);
+		if (!skip_vma_uprobe) {
+			uprobe_mmap(vma);
+
+			if (adjust_next)
+				uprobe_mmap(next);
+		}
 	}
 
 	if (remove_next) {
@@ -881,6 +884,13 @@ int __vma_adjust(struct vm_area_struct *vma, unsigned long start,
 	return 0;
 }
 
+int __vma_adjust(struct vm_area_struct *vma, unsigned long start,
+	unsigned long end, pgoff_t pgoff, struct vm_area_struct *insert,
+	struct vm_area_struct *expand)
+{
+	return ___vma_adjust(vma, start, end, pgoff, insert, expand, false);
+}
+
 /*
  * If the vma has a ->close operation then the driver probably needs to release
  * per-vma resources, so we don't attempt to merge those.
@@ -1018,13 +1028,13 @@ can_vma_merge_after(struct vm_area_struct *vma, unsigned long vm_flags,
  * parameter) may establish ptes with the wrong permissions of NNNN
  * instead of the right permissions of XXXX.
  */
-struct vm_area_struct *vma_merge(struct mm_struct *mm,
+static struct vm_area_struct *__vma_merge(struct mm_struct *mm,
 			struct vm_area_struct *prev, unsigned long addr,
 			unsigned long end, unsigned long vm_flags,
 			struct anon_vma *anon_vma, struct file *file,
 			pgoff_t pgoff, struct mempolicy *policy,
 			struct vm_userfaultfd_ctx vm_userfaultfd_ctx,
-			struct anon_vma_name *anon_name)
+			struct anon_vma_name *anon_name, bool skip_vma_uprobe)
 {
 	pgoff_t pglen = (end - addr) >> PAGE_SHIFT;
 	struct vm_area_struct *mid, *next, *res;
@@ -1069,21 +1079,24 @@ struct vm_area_struct *vma_merge(struct mm_struct *mm,
 	if (merge_prev && merge_next &&
 			is_mergeable_anon_vma(prev->anon_vma,
 				next->anon_vma, NULL)) {	 /* cases 1, 6 */
-		err = __vma_adjust(prev, prev->vm_start,
+		err = ___vma_adjust(prev, prev->vm_start,
 					next->vm_end, prev->vm_pgoff, NULL,
-					prev);
+					prev, skip_vma_uprobe);
 		res = prev;
 	} else if (merge_prev) {			/* cases 2, 5, 7 */
-		err = __vma_adjust(prev, prev->vm_start,
-					end, prev->vm_pgoff, NULL, prev);
+		err = ___vma_adjust(prev, prev->vm_start,
+					end, prev->vm_pgoff, NULL, prev,
+					skip_vma_uprobe);
 		res = prev;
 	} else if (merge_next) {
 		if (prev && addr < prev->vm_end)	/* case 4 */
-			err = __vma_adjust(prev, prev->vm_start,
-					addr, prev->vm_pgoff, NULL, next);
+			err = ___vma_adjust(prev, prev->vm_start,
+					addr, prev->vm_pgoff, NULL, next,
+					skip_vma_uprobe);
 		else					/* cases 3, 8 */
-			err = __vma_adjust(mid, addr, next->vm_end,
-					next->vm_pgoff - pglen, NULL, next);
+			err = ___vma_adjust(mid, addr, next->vm_end,
+					next->vm_pgoff - pglen, NULL, next,
+					skip_vma_uprobe);
 		res = next;
 	}
 
@@ -1096,6 +1109,18 @@ struct vm_area_struct *vma_merge(struct mm_struct *mm,
 	return res;
 }
 
+struct vm_area_struct *vma_merge(struct mm_struct *mm,
+			struct vm_area_struct *prev, unsigned long addr,
+			unsigned long end, unsigned long vm_flags,
+			struct anon_vma *anon_vma, struct file *file,
+			pgoff_t pgoff, struct mempolicy *policy,
+			struct vm_userfaultfd_ctx vm_userfaultfd_ctx,
+			struct anon_vma_name *anon_name)
+{
+	return __vma_merge(mm, prev, addr, end, vm_flags, anon_vma, file,
+			   pgoff, policy, vm_userfaultfd_ctx, anon_name, false);
+}
+
 /*
  * Rough compatibility check to quickly see if it's even worth looking
  * at sharing an anon_vma.
@@ -3380,6 +3405,7 @@ struct vm_area_struct *copy_vma(struct vm_area_struct **vmap,
 	struct vm_area_struct *new_vma, *prev;
 	bool faulted_in_anon_vma = true;
 	bool can_self_merge = false;
+	bool skip_vma_uprobe = false;
 
 	validate_mm_mt(mm);
 	/*
@@ -3392,6 +3418,14 @@ struct vm_area_struct *copy_vma(struct vm_area_struct **vmap,
 		can_self_merge = true;
 	}
 
+	/*
+	 * If the VMA we are copying might contain a uprobe PTE, ensure
+	 * that we do not establish one upon merge. Otherwise, when mremap()
+	 * moves page tables, it will orphan the newly created PTE.
+	 */
+	if (vma->vm_file)
+		skip_vma_uprobe = true;
+
 	new_vma = find_vma_prev(mm, addr, &prev);
 	if (new_vma && new_vma->vm_start < addr + len)
 		return NULL;	/* should never get here */
@@ -3408,10 +3442,10 @@ struct vm_area_struct *copy_vma(struct vm_area_struct **vmap,
 	    (addr == vma->vm_end || vma->vm_start == addr + len))
 		new_vma = NULL;
 	else
-		new_vma = vma_merge(mm, prev, addr, addr + len, vma->vm_flags,
-				    vma->anon_vma, vma->vm_file, pgoff,
-				    vma_policy(vma), vma->vm_userfaultfd_ctx,
-				    anon_vma_name(vma));
+		new_vma = __vma_merge(mm, prev, addr, addr + len, vma->vm_flags,
+				      vma->anon_vma, vma->vm_file, pgoff,
+				      vma_policy(vma), vma->vm_userfaultfd_ctx,
+				      anon_vma_name(vma), skip_vma_uprobe);
 	if (new_vma) {
 		/*
 		 * Source vma may have been merged into new_vma
