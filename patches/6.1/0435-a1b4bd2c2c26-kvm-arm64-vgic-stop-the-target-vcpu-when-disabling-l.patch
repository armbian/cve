X-Fasttrack-Source: claude
X-Fasttrack-Upstream: a1b4bd2c2c262b8094c86afb99364d16ac08cb66
X-Fasttrack-CVE: CVE-2026-99573
X-Fasttrack-Backport: cve/CVE-2026-99573/6.1
From: Marc Zyngier <maz@kernel.org>
Date: Thu, 15 Oct 2026 11:05:38 +0100
Subject: [PATCH] KVM: arm64: vgic: Stop the target vcpu when disabling LPIs

commit a1b4bd2c2c262b8094c86afb99364d16ac08cb66 upstream.

[ Backport: 6.1 has no kvm_pause_vcpu() and arch.pause is a bool, so halt the guest under config_lock, as the 6.1 active-state accessors do. Userspace writes hold config_lock with all vcpus locked, so give GICR_CTLR a uaccess_write that skips the halt. vgic_its_invalidate_all_caches() is vgic_its_invalidate_cache() in 6.1. ]

Disabling LPIs is pretty nasty, as it directly messes with the AP list
of the affected CPU, which could be running... This has the potential to
lead to really bad behaviours, and we should not be doing that.

Take example on the way the Active state is handled and simply pause the
the vcpu so that we are sure it is in a quiescent state, and the state be
safely manipulated.

Nobody has any expectation of performance for this anyway.

Fixes: 96085b949672d ("KVM: arm/arm64: vgic-v3: Retire pending interrupts on disabling LPIs")
Co-developed-by: Oliver Upton <oupton@kernel.org>
Signed-off-by: Oliver Upton <oupton@kernel.org>
Cc: stable@vger.kernel.org
Reviewed-by: Fuad Tabba <fuad.tabba@linux.dev>
Tested-by: Fuad Tabba <fuad.tabba@linux.dev>
Link: https://patch.msgid.link/20261015100539.1011760-7-maz@kernel.org
Signed-off-by: Marc Zyngier <maz@kernel.org>
---
 arch/arm64/kvm/vgic/vgic-mmio-v3.c | 45 ++++++++++++++++++++++++++----
 1 file changed, 40 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/kvm/vgic/vgic-mmio-v3.c b/arch/arm64/kvm/vgic/vgic-mmio-v3.c
index 4c470f20adab..fa1c75ead81b 100644
--- a/arch/arm64/kvm/vgic/vgic-mmio-v3.c
+++ b/arch/arm64/kvm/vgic/vgic-mmio-v3.c
@@ -255,9 +255,8 @@ static unsigned long vgic_mmio_read_v3r_ctlr(struct kvm_vcpu *vcpu,
 	return val;
 }
 
-static void vgic_mmio_write_v3r_ctlr(struct kvm_vcpu *vcpu,
-				     gpa_t addr, unsigned int len,
-				     unsigned long val)
+static void __vgic_mmio_write_v3r_ctlr(struct kvm_vcpu *vcpu,
+				       unsigned long val, bool halt)
 {
 	struct vgic_cpu *vgic_cpu = &vcpu->arch.vgic_cpu;
 	u32 ctlr;
@@ -276,9 +275,25 @@ static void vgic_mmio_write_v3r_ctlr(struct kvm_vcpu *vcpu,
 		if (ctlr != GICR_CTLR_ENABLE_LPIS)
 			return;
 
+		/*
+		 * Yes, disabling LPIs is painful, since it can be done from
+		 * a *remote* vcpu! So let's not take any chance, and make
+		 * sure that the target vCPU has written their LRs back to the
+		 * irq structures, and release any reference they would have.
+		 *
+		 * If it hurts, don't do it.
+		 */
+		if (halt) {
+			mutex_lock(&vcpu->kvm->arch.config_lock);
+			kvm_arm_halt_guest(vcpu->kvm);
+		}
 		vgic_flush_pending_lpis(vcpu);
 		vgic_its_invalidate_cache(vcpu->kvm);
 		atomic_set_release(&vgic_cpu->ctlr, 0);
+		if (halt) {
+			kvm_arm_resume_guest(vcpu->kvm);
+			mutex_unlock(&vcpu->kvm->arch.config_lock);
+		}
 	} else {
 		ctlr = atomic_cmpxchg_acquire(&vgic_cpu->ctlr, 0,
 					      GICR_CTLR_ENABLE_LPIS);
@@ -289,6 +304,25 @@ static void vgic_mmio_write_v3r_ctlr(struct kvm_vcpu *vcpu,
 	}
 }
 
+static void vgic_mmio_write_v3r_ctlr(struct kvm_vcpu *vcpu,
+				     gpa_t addr, unsigned int len,
+				     unsigned long val)
+{
+	__vgic_mmio_write_v3r_ctlr(vcpu, val, true);
+}
+
+/*
+ * Userspace holds config_lock and has locked all vcpus, so no vcpu runs:
+ * there is nothing to halt.
+ */
+static int vgic_mmio_uaccess_write_v3r_ctlr(struct kvm_vcpu *vcpu,
+					    gpa_t addr, unsigned int len,
+					    unsigned long val)
+{
+	__vgic_mmio_write_v3r_ctlr(vcpu, val, false);
+	return 0;
+}
+
 static bool vgic_mmio_vcpu_rdist_is_last(struct kvm_vcpu *vcpu)
 {
 	struct vgic_dist *vgic = &vcpu->kvm->arch.vgic;
@@ -678,8 +712,9 @@ static const struct vgic_register_region vgic_v3_dist_registers[] = {
 
 static const struct vgic_register_region vgic_v3_rd_registers[] = {
 	/* RD_base registers */
-	REGISTER_DESC_WITH_LENGTH(GICR_CTLR,
-		vgic_mmio_read_v3r_ctlr, vgic_mmio_write_v3r_ctlr, 4,
+	REGISTER_DESC_WITH_LENGTH_UACCESS(GICR_CTLR,
+		vgic_mmio_read_v3r_ctlr, vgic_mmio_write_v3r_ctlr,
+		NULL, vgic_mmio_uaccess_write_v3r_ctlr, 4,
 		VGIC_ACCESS_32bit),
 	REGISTER_DESC_WITH_LENGTH(GICR_STATUSR,
 		vgic_mmio_read_raz, vgic_mmio_write_wi, 4,
