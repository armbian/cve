X-Fasttrack-Source: claude
X-Fasttrack-Upstream: 4e3c87b9421df497d849ae61aab9762de7f66afb
X-Fasttrack-CVE: CVE-2026-53185
X-Fasttrack-Backport: cve/CVE-2026-53185/6.1
From: Christoph Hellwig <hch@lst.de>
Date: Sun, 1 Nov 2026 12:55:57 +0100
Subject: [PATCH] zram: fix synchronous reads

commit 4e3c87b9421df497d849ae61aab9762de7f66afb upstream.

[ Backport: take only the switch of zram_sync_read() to an on-stack bio and submit_bio_wait(). This fixes CVE-2026-53185 in 6.1. ]
[ Backport: 6.1 already passes partial_io=true from zram_bvec_write(), so the 732fd9f0b9c1 one-line change is not needed. ]
[ Backport: keep the partial_io/sync flag and the bvec interface. Dropping them needs the 6.4 zram refactor. ]
[ Backport: keep zram_page_end_io(). In 6.1 a NULL parent bio never reaches read_from_bdev(). ]
[ Backport: drop the bio argument also from the PAGE_SIZE == 4096 read_from_bdev_sync() stub. ]

Currently nothing waits for the synchronous reads before accessing the
data.  Switch them to an on-stack bio and submit_bio_wait to make sure the
I/O has actually completed when the work item has been flushed.  This also
removes the call to page_endio that would unlock a page that has never
been locked.

Drop the partial_io/sync flag, as chaining only makes sense for the
asynchronous reads of the entire page.

Link: https://lkml.kernel.org/r/20230411171459.567614-17-hch@lst.de
Signed-off-by: Christoph Hellwig <hch@lst.de>
Reviewed-by: Sergey Senozhatsky <senozhatsky@chromium.org>
Acked-by: Minchan Kim <minchan@kernel.org>
Cc: Jens Axboe <axboe@kernel.dk>
Signed-off-by: Andrew Morton <akpm@linux-foundation.org>
---
 drivers/block/zram/zram_drv.c | 19 ++++++++++---------
 1 file changed, 10 insertions(+), 9 deletions(-)

diff --git a/drivers/block/zram/zram_drv.c b/drivers/block/zram/zram_drv.c
index b8a2cb2f901c..92c70f8ee95d 100644
--- a/drivers/block/zram/zram_drv.c
+++ b/drivers/block/zram/zram_drv.c
@@ -818,7 +818,6 @@ struct zram_work {
 	struct work_struct work;
 	struct zram *zram;
 	unsigned long entry;
-	struct bio *bio;
 	struct bio_vec bvec;
 };
 
@@ -826,11 +825,14 @@ struct zram_work {
 static void zram_sync_read(struct work_struct *work)
 {
 	struct zram_work *zw = container_of(work, struct zram_work, work);
-	struct zram *zram = zw->zram;
-	unsigned long entry = zw->entry;
-	struct bio *bio = zw->bio;
+	struct bio_vec bv;
+	struct bio bio;
 
-	read_from_bdev_async(zram, &zw->bvec, entry, bio);
+	bio_init(&bio, zw->zram->bdev, &bv, 1, REQ_OP_READ);
+	bio.bi_iter.bi_sector = zw->entry * (PAGE_SIZE >> 9);
+	__bio_add_page(&bio, zw->bvec.bv_page, zw->bvec.bv_len,
+		       zw->bvec.bv_offset);
+	submit_bio_wait(&bio);
 }
 
 /*
@@ -839,14 +841,13 @@ static void zram_sync_read(struct work_struct *work)
  * use a worker thread context.
  */
 static int read_from_bdev_sync(struct zram *zram, struct bio_vec *bvec,
-				unsigned long entry, struct bio *bio)
+				unsigned long entry)
 {
 	struct zram_work work;
 
 	work.bvec = *bvec;
 	work.zram = zram;
 	work.entry = entry;
-	work.bio = bio;
 
 	INIT_WORK_ONSTACK(&work.work, zram_sync_read);
 	queue_work(system_unbound_wq, &work.work);
@@ -857,7 +858,7 @@ static int read_from_bdev_sync(struct zram *zram, struct bio_vec *bvec,
 }
 #else
 static int read_from_bdev_sync(struct zram *zram, struct bio_vec *bvec,
-				unsigned long entry, struct bio *bio)
+				unsigned long entry)
 {
 	WARN_ON(1);
 	return -EIO;
@@ -869,7 +870,7 @@ static int read_from_bdev(struct zram *zram, struct bio_vec *bvec,
 {
 	atomic64_inc(&zram->stats.bd_reads);
 	if (sync)
-		return read_from_bdev_sync(zram, bvec, entry, parent);
+		return read_from_bdev_sync(zram, bvec, entry);
 	else
 		return read_from_bdev_async(zram, bvec, entry, parent);
 }
