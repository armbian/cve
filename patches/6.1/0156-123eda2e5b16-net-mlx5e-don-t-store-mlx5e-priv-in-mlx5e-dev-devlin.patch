 .../net/ethernet/mellanox/mlx5/core/en_main.c | 22 ++++++++++---------
 1 file changed, 12 insertions(+), 10 deletions(-)

diff --git a/drivers/net/ethernet/mellanox/mlx5/core/en_main.c b/drivers/net/ethernet/mellanox/mlx5/core/en_main.c
index b14c063c87c2..85dff46d1195 100644
--- a/drivers/net/ethernet/mellanox/mlx5/core/en_main.c
+++ b/drivers/net/ethernet/mellanox/mlx5/core/en_main.c
@@ -5882,8 +5882,8 @@ void mlx5e_destroy_netdev(struct net_device *netdev)
 static int mlx5e_resume(struct auxiliary_device *adev)
 {
 	struct mlx5_adev *edev = container_of(adev, struct mlx5_adev, adev);
-	struct mlx5e_priv *priv = auxiliary_get_drvdata(adev);
-	struct net_device *netdev = priv->netdev;
+	struct net_device *netdev = auxiliary_get_drvdata(adev);
+	struct mlx5e_priv *priv = netdev_priv(netdev);
 	struct mlx5_core_dev *mdev = edev->mdev;
 	int err;
 
@@ -5906,9 +5906,10 @@ static int mlx5e_resume(struct auxiliary_device *adev)
 static int mlx5e_suspend_common(struct auxiliary_device *adev,
 				bool pre_netdev_reg)
 {
-	struct mlx5e_priv *priv = auxiliary_get_drvdata(adev);
-	struct net_device *netdev = priv->netdev;
-	struct mlx5_core_dev *mdev = priv->mdev;
+	struct mlx5_adev *edev = container_of(adev, struct mlx5_adev, adev);
+	struct net_device *netdev = auxiliary_get_drvdata(adev);
+	struct mlx5e_priv *priv = netdev_priv(netdev);
+	struct mlx5_core_dev *mdev = edev->mdev;
 
 	if (!pre_netdev_reg && !netif_device_present(netdev)) {
 		if (test_bit(MLX5E_STATE_DESTROYING, &priv->state))
@@ -5941,11 +5942,11 @@ static int mlx5e_probe(struct auxiliary_device *adev,
 		mlx5_core_err(mdev, "mlx5e_create_netdev failed\n");
 		return -ENOMEM;
 	}
+	auxiliary_set_drvdata(adev, netdev);
 
 	mlx5e_build_nic_netdev(netdev);
 
 	priv = netdev_priv(netdev);
-	auxiliary_set_drvdata(adev, priv);
 
 	priv->profile = profile;
 	priv->ppriv = NULL;
@@ -5993,15 +5994,16 @@ static int mlx5e_probe(struct auxiliary_device *adev,
 
 static void mlx5e_remove(struct auxiliary_device *adev)
 {
-	struct mlx5e_priv *priv = auxiliary_get_drvdata(adev);
-	struct net_device *netdev = priv->netdev;
+	struct mlx5_adev *edev = container_of(adev, struct mlx5_adev, adev);
+	struct net_device *netdev = auxiliary_get_drvdata(adev);
+	struct mlx5e_priv *priv = netdev_priv(netdev);
 	pm_message_t state = {};
 
-	mlx5_uplink_netdev_set(priv->mdev, NULL);
+	mlx5_uplink_netdev_set(edev->mdev, NULL);
 
 	if (priv->profile)
 		mlx5e_dcbnl_delete_app(priv);
-	unregister_netdev(priv->netdev);
+	unregister_netdev(netdev);
 	mlx5e_suspend(adev, state);
 	/* Avoid cleanup if profile rollback failed. */
 	if (priv->profile)
