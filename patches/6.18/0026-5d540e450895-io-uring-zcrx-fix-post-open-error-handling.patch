From: Pavel Begunkov <asml.silence@gmail.com>
Date: Sat, 31 Oct 2026 07:40:14 +0100
Subject: [PATCH] io_uring/zcrx: fix post open error handling

commit 5d540e4508950c674d6feef1d95463d039bbf4f5 upstream.

[ Backport: 6.18 lacks the ifq refcounting (75c299a917e4) and the
  user_refs/zcrx_unregister() infrastructure (39c9676f789e and later).
  Add a minimal ifq->refs: page pools take a reference in
  io_pp_zc_init() and drop it in io_pp_zc_destroy() (on top of the
  existing ctx->refs, which is kept and dropped last so ifq->ctx stays
  valid while freeing), and io_unregister_zcrx_ifqs() puts the ring's
  reference instead of freeing directly.
  Add a local zcrx_unregister() doing close queue + scrub + put, like
  upstream's single-user case, with a forward declaration of
  io_zcrx_scrub(), which is defined later in this tree. ]

Closing a queue doesn't guarantee that all associated page pools are
terminated right away, let the refcounting do the work instead of
releasing the zcrx ctx directly.

Cc: stable@vger.kernel.org
Fixes: e0793de24a9f6 ("io_uring/zcrx: set pp memory provider for an rx queue")
Signed-off-by: Pavel Begunkov <asml.silence@gmail.com>
Signed-off-by: Jens Axboe <axboe@kernel.dk>
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 io_uring/zcrx.c | 32 ++++++++++++++++++++++++--------
 io_uring/zcrx.h |  1 +
 2 files changed, 25 insertions(+), 8 deletions(-)

diff --git a/io_uring/zcrx.c b/io_uring/zcrx.c
index b725dab91732..9841f5b25ec9 100644
--- a/io_uring/zcrx.c
+++ b/io_uring/zcrx.c
@@ -488,6 +488,7 @@ static struct io_zcrx_ifq *io_zcrx_ifq_alloc(struct io_ring_ctx *ctx)
 	ifq->ctx = ctx;
 	spin_lock_init(&ifq->rq_lock);
 	mutex_init(&ifq->pp_lock);
+	refcount_set(&ifq->refs, 1);
 	return ifq;
 }
 
@@ -510,9 +511,6 @@ static void io_close_queue(struct io_zcrx_ifq *ifq)
 		.mp_priv = ifq,
 	};
 
-	if (ifq->if_rxq == -1)
-		return;
-
 	scoped_guard(mutex, &ifq->pp_lock) {
 		netdev = ifq->netdev;
 		netdev_tracker = ifq->netdev_tracker;
@@ -520,7 +518,8 @@ static void io_close_queue(struct io_zcrx_ifq *ifq)
 	}
 
 	if (netdev) {
-		net_mp_close_rxq(netdev, ifq->if_rxq, &p);
+		if (ifq->if_rxq != -1)
+			net_mp_close_rxq(netdev, ifq->if_rxq, &p);
 		netdev_put(netdev, &netdev_tracker);
 	}
 	ifq->if_rxq = -1;
@@ -540,6 +539,21 @@ static void io_zcrx_ifq_free(struct io_zcrx_ifq *ifq)
 	kfree(ifq);
 }
 
+static void io_put_zcrx_ifq(struct io_zcrx_ifq *ifq)
+{
+	if (refcount_dec_and_test(&ifq->refs))
+		io_zcrx_ifq_free(ifq);
+}
+
+static void io_zcrx_scrub(struct io_zcrx_ifq *ifq);
+
+static void zcrx_unregister(struct io_zcrx_ifq *ifq)
+{
+	io_close_queue(ifq);
+	io_zcrx_scrub(ifq);
+	io_put_zcrx_ifq(ifq);
+}
+
 struct io_mapped_region *io_zcrx_get_region(struct io_ring_ctx *ctx,
 					    unsigned int id)
 {
@@ -651,13 +665,12 @@ int io_register_zcrx_ifq(struct io_ring_ctx *ctx,
 	}
 	return 0;
 netdev_put_unlock:
-	netdev_put(ifq->netdev, &ifq->netdev_tracker);
 	netdev_unlock(ifq->netdev);
 err:
 	scoped_guard(mutex, &ctx->mmap_lock)
 		xa_erase(&ctx->zcrx_ctxs, id);
 ifq_free:
-	io_zcrx_ifq_free(ifq);
+	zcrx_unregister(ifq);
 	return ret;
 }
 
@@ -677,7 +690,7 @@ void io_unregister_zcrx_ifqs(struct io_ring_ctx *ctx)
 		}
 		if (!ifq)
 			break;
-		io_zcrx_ifq_free(ifq);
+		io_put_zcrx_ifq(ifq);
 	}
 
 	xa_destroy(&ctx->zcrx_ctxs);
@@ -895,6 +908,7 @@ static int io_pp_zc_init(struct page_pool *pp)
 	if (ret)
 		return ret;
 
+	refcount_inc(&ifq->refs);
 	percpu_ref_get(&ifq->ctx->refs);
 	return 0;
 }
@@ -902,8 +916,10 @@ static int io_pp_zc_init(struct page_pool *pp)
 static void io_pp_zc_destroy(struct page_pool *pp)
 {
 	struct io_zcrx_ifq *ifq = io_pp_to_ifq(pp);
+	struct io_ring_ctx *ctx = ifq->ctx;
 
-	percpu_ref_put(&ifq->ctx->refs);
+	io_put_zcrx_ifq(ifq);
+	percpu_ref_put(&ctx->refs);
 }
 
 static int io_pp_nl_fill(void *mp_priv, struct sk_buff *rsp,
diff --git a/io_uring/zcrx.h b/io_uring/zcrx.h
index a48871b5adad..5015d44c45b0 100644
--- a/io_uring/zcrx.h
+++ b/io_uring/zcrx.h
@@ -53,6 +53,7 @@ struct io_zcrx_ifq {
 	struct device			*dev;
 	struct net_device		*netdev;
 	netdevice_tracker		netdev_tracker;
+	refcount_t			refs;
 
 	/*
 	 * Page pool and net configuration lock, can be taken deeper in the
