From: Daniel Machon <daniel.machon@microchip.com>
Date: Sat, 31 Oct 2026 07:46:23 +0100
Subject: [PATCH] net: sparx5: fix sleep in atomic context in MAC table access

commit b62793a7baeea9cf20209c9fd2e333311aaf3b8d upstream.

[ Backport: 6.18 has no .ndo_set_rx_mode_async (commit 3554b4345d85 and
  its snapshot prerequisite db9e726525e4 are ~450 lines of net/core
  infrastructure), so instead of moving the whole callback to process
  context, sparx5_set_rx_mode() now syncs dev->mc with new
  sparx5_mc_{sync,unsync}_atomic() callbacks that queue the learn/forget
  request (GFP_ATOMIC, spinlock) and a work item performs it via
  sparx5_mact_learn()/sparx5_mact_forget() in process context. The
  mutex and the sleeping completion poll remain, as upstream. ]
[ Backport: bridge join/leave flush the queued requests before they sync
  the MC list directly, so a deferred request cannot be applied out of
  order; sparx5_mact_deinit() cancels the work and frees leftovers. ]
[ Backport: hardware learn errors from the deferred path are no longer
  reported back to __hw_addr_sync_dev(); only allocation failure is. ]

sparx5_set_rx_mode() runs with netif_addr_lock_bh held and iterates
dev->mc via __dev_mc_sync(), which per address calls sparx5_mc_sync() /
sparx5_mc_unsync() -> sparx5_mact_learn() / sparx5_mact_forget().  These
take sparx5->lock, a mutex, and then poll the MAC access command
register with readx_poll_timeout(). A mutex may block, which is not
allowed from atomic context.

Convert the driver to the new .ndo_set_rx_mode_async callback introduced
in commit 3554b4345d85 ("net: introduce ndo_set_rx_mode_async and
netdev_rx_mode_work"). The async callback is invoked from process
context, so the mutex and sleeping completion poll can remain.

Observed with CONFIG_PROVE_LOCKING, CONFIG_DEBUG_SPINLOCK,
CONFIG_DEBUG_MUTEXES and CONFIG_DEBUG_ATOMIC_SLEEP enabled:

  BUG: sleeping function called from invalid context at kernel/locking/mutex.c:591
  in_atomic(): 1, irqs_disabled(): 0, non_block: 0, pid: 217, name: ip
  preempt_count: 201, expected: 0
  Call trace:
   __might_resched+0x144/0x248
   __might_sleep+0x48/0x7c
   __mutex_lock+0x74/0x850
   mutex_lock_nested+0x24/0x30
   sparx5_mact_learn+0x78/0x100
   sparx5_mc_sync+0x40/0x54
   __hw_addr_sync_dev+0xc4/0x170
   sparx5_set_rx_mode+0x4c/0x58
   __dev_set_rx_mode+0x64/0xa4
   __dev_open+0x1ec/0x26c

Fixes: d6fce5141929 ("net: sparx5: add switching support")
Signed-off-by: Daniel Machon <daniel.machon@microchip.com>
Link: https://patch.msgid.link/20260817-misc-fixes-sparx5-lan969x-v3-2-c7c7fef723a8@microchip.com
Signed-off-by: Jakub Kicinski <kuba@kernel.org>
Signed-off-by: Igor Pecovnik <igor@armbian.com>
---
 .../microchip/sparx5/sparx5_mactable.c        | 84 +++++++++++++++++++
 .../ethernet/microchip/sparx5/sparx5_main.h   |  7 ++
 .../ethernet/microchip/sparx5/sparx5_netdev.c |  3 +-
 .../microchip/sparx5/sparx5_switchdev.c       |  2 +
 4 files changed, 95 insertions(+), 1 deletion(-)

diff --git a/drivers/net/ethernet/microchip/sparx5/sparx5_mactable.c b/drivers/net/ethernet/microchip/sparx5/sparx5_mactable.c
index 2bf9c5f64151..a4399ec1db1b 100644
--- a/drivers/net/ethernet/microchip/sparx5/sparx5_mactable.c
+++ b/drivers/net/ethernet/microchip/sparx5/sparx5_mactable.c
@@ -133,6 +133,79 @@ int sparx5_mc_sync(struct net_device *dev, const unsigned char *addr)
 				 addr, port->pvid);
 }
 
+struct sparx5_mc_op {
+	struct list_head list;
+	unsigned char addr[ETH_ALEN];
+	u16 vid;
+	bool learn;
+};
+
+/* ndo_set_rx_mode runs in atomic context, but MAC table access takes a
+ * mutex and sleeps while polling for completion. Queue the request and
+ * perform it from process context in sparx5_mc_work().
+ */
+static int sparx5_mc_queue(struct net_device *dev, const unsigned char *addr,
+			   bool learn)
+{
+	struct sparx5_port *port = netdev_priv(dev);
+	struct sparx5 *sparx5 = port->sparx5;
+	struct sparx5_mc_op *op;
+
+	op = kzalloc(sizeof(*op), GFP_ATOMIC);
+	if (!op)
+		return -ENOMEM;
+
+	ether_addr_copy(op->addr, addr);
+	op->vid = port->pvid;
+	op->learn = learn;
+
+	spin_lock_bh(&sparx5->mc_ops_lock);
+	list_add_tail(&op->list, &sparx5->mc_ops);
+	spin_unlock_bh(&sparx5->mc_ops_lock);
+
+	schedule_work(&sparx5->mc_work);
+
+	return 0;
+}
+
+int sparx5_mc_unsync_atomic(struct net_device *dev, const unsigned char *addr)
+{
+	return sparx5_mc_queue(dev, addr, false);
+}
+
+int sparx5_mc_sync_atomic(struct net_device *dev, const unsigned char *addr)
+{
+	return sparx5_mc_queue(dev, addr, true);
+}
+
+static void sparx5_mc_work(struct work_struct *work)
+{
+	struct sparx5 *sparx5 = container_of(work, struct sparx5, mc_work);
+	struct sparx5_mc_op *op, *tmp;
+	LIST_HEAD(ops);
+
+	spin_lock_bh(&sparx5->mc_ops_lock);
+	list_splice_init(&sparx5->mc_ops, &ops);
+	spin_unlock_bh(&sparx5->mc_ops_lock);
+
+	list_for_each_entry_safe(op, tmp, &ops, list) {
+		if (op->learn)
+			sparx5_mact_learn(sparx5,
+					  sparx5_get_pgid(sparx5, PGID_CPU),
+					  op->addr, op->vid);
+		else
+			sparx5_mact_forget(sparx5, op->addr, op->vid);
+		list_del(&op->list);
+		kfree(op);
+	}
+}
+
+/* Complete queued requests before touching the MC entries directly */
+void sparx5_mc_flush(struct sparx5 *sparx5)
+{
+	flush_work(&sparx5->mc_work);
+}
+
 static int sparx5_mact_get(struct sparx5 *sparx5,
 			   unsigned char mac[ETH_ALEN],
 			   u16 *vid, u32 *pcfg2)
@@ -494,6 +567,9 @@ int sparx5_mact_init(struct sparx5 *sparx5)
 	char queue_name[32];
 
 	mutex_init(&sparx5->lock);
+	INIT_LIST_HEAD(&sparx5->mc_ops);
+	spin_lock_init(&sparx5->mc_ops_lock);
+	INIT_WORK(&sparx5->mc_work, sparx5_mc_work);
 
 	/*  Flush MAC table */
 	spx5_wr(LRN_COMMON_ACCESS_CTRL_CPU_ACCESS_CMD_SET(MAC_CMD_CLEAR_ALL) |
@@ -529,6 +605,14 @@ int sparx5_mact_init(struct sparx5 *sparx5)
 
 void sparx5_mact_deinit(struct sparx5 *sparx5)
 {
+	struct sparx5_mc_op *op, *tmp;
+
+	cancel_work_sync(&sparx5->mc_work);
+	list_for_each_entry_safe(op, tmp, &sparx5->mc_ops, list) {
+		list_del(&op->list);
+		kfree(op);
+	}
+
 	cancel_delayed_work_sync(&sparx5->mact_work);
 	destroy_workqueue(sparx5->mact_queue);
 	mutex_destroy(&sparx5->mact_lock);
diff --git a/drivers/net/ethernet/microchip/sparx5/sparx5_main.h b/drivers/net/ethernet/microchip/sparx5/sparx5_main.h
index a5675f13a11e..4da8080ed3a4 100644
--- a/drivers/net/ethernet/microchip/sparx5/sparx5_main.h
+++ b/drivers/net/ethernet/microchip/sparx5/sparx5_main.h
@@ -410,6 +410,10 @@ struct sparx5 {
 	struct mutex mdb_lock;
 	struct delayed_work mact_work;
 	struct workqueue_struct *mact_queue;
+	/* MC learn/forget requests deferred from ndo_set_rx_mode */
+	struct list_head mc_ops;
+	spinlock_t mc_ops_lock; /* protects mc_ops */
+	struct work_struct mc_work;
 	/* Board specifics */
 	bool sd_sgpio_remapping;
 	/* Register based inj/xtr */
@@ -488,6 +492,9 @@ int sparx5_del_mact_entry(struct sparx5 *sparx5,
 			  u16 vid);
 int sparx5_mc_sync(struct net_device *dev, const unsigned char *addr);
 int sparx5_mc_unsync(struct net_device *dev, const unsigned char *addr);
+int sparx5_mc_sync_atomic(struct net_device *dev, const unsigned char *addr);
+int sparx5_mc_unsync_atomic(struct net_device *dev, const unsigned char *addr);
+void sparx5_mc_flush(struct sparx5 *sparx5);
 void sparx5_set_ageing(struct sparx5 *sparx5, int msecs);
 int sparx5_mact_init(struct sparx5 *sparx5);
 void sparx5_mact_deinit(struct sparx5 *sparx5);
diff --git a/drivers/net/ethernet/microchip/sparx5/sparx5_netdev.c b/drivers/net/ethernet/microchip/sparx5/sparx5_netdev.c
index ae84ab737882..6e4b7420d719 100644
--- a/drivers/net/ethernet/microchip/sparx5/sparx5_netdev.c
+++ b/drivers/net/ethernet/microchip/sparx5/sparx5_netdev.c
@@ -168,7 +168,8 @@ static void sparx5_set_rx_mode(struct net_device *dev)
 	struct sparx5 *sparx5 = port->sparx5;
 
 	if (!test_bit(port->portno, sparx5->bridge_mask))
-		__dev_mc_sync(dev, sparx5_mc_sync, sparx5_mc_unsync);
+		__dev_mc_sync(dev, sparx5_mc_sync_atomic,
+			      sparx5_mc_unsync_atomic);
 }
 
 static int sparx5_port_get_phys_port_name(struct net_device *dev,
diff --git a/drivers/net/ethernet/microchip/sparx5/sparx5_switchdev.c b/drivers/net/ethernet/microchip/sparx5/sparx5_switchdev.c
index 391ce604e661..985ca0696212 100644
--- a/drivers/net/ethernet/microchip/sparx5/sparx5_switchdev.c
+++ b/drivers/net/ethernet/microchip/sparx5/sparx5_switchdev.c
@@ -204,6 +204,7 @@ static int sparx5_port_bridge_join(struct sparx5_port *port,
 	/* Port enters in bridge mode therefore don't need to copy to CPU
 	 * frames for multicast in case the bridge is not requesting them
 	 */
+	sparx5_mc_flush(sparx5);
 	__dev_mc_unsync(ndev, sparx5_mc_unsync);
 
 	/* Enable uc/mc/bc flooding */
@@ -240,6 +241,7 @@ static void sparx5_port_bridge_leave(struct sparx5_port *port,
 			  port->ndev->dev_addr, 0);
 
 	/* Port enters in host more therefore restore mc list */
+	sparx5_mc_flush(sparx5);
 	__dev_mc_sync(port->ndev, sparx5_mc_sync, sparx5_mc_unsync);
 
 	/* Disable uc/mc/bc flooding */
