-		bpf_obj_free_fields(htab->map.record, map_value);
+		bpf_obj_cancel_fields(&htab->map, map_value);
 	}
 }
 
@@ -903,7 +907,7 @@ static bool htab_lru_map_delete_node(void *arg, struct bpf_lru_node *node)
