 	if (unlikely(pud_none(pud)))
@@ -358,9 +354,7 @@ static bool move_normal_pud(struct vm_area_struct *vma, unsigned long old_addr,
 	pud_populate(mm, new_pud, pud_pgtable(pud));
 	flush_tlb_range(vma, old_addr, old_addr + PUD_SIZE);
